# Copy to .env for local use. Real values belong only in .env / Render settings.
# Restore existing production values; generating replacements changes authentication.
PORT=10000
WEATHER_STATION_HOST=myweather.ddns.net
WEATHER_STATION_PORT=8899

# Optional SQL archive (Node 24.14+). Blank means disabled.
# Local: data/weather.sqlite. Render: /var/data/weather.sqlite on a persistent disk.
WEATHER_DB_PATH=
# Optional path to a separately verified sensor/storage layout JSON.
WEATHER_DB_LAYOUT=
# Bounded 4-8 KB memory tails, serialized with normal station polling.
WEATHER_HISTORY_ENABLED=false
# Daily native SQLite backups, compressed; retains three on the persistent disk.
WEATHER_BACKUP_DIR=
# Device push alerts use the same disk; enabled by default when WEATHER_DB_PATH is set.
# Disable when running against a real station during local development.
WEATHER_ALERTS_ENABLED=false

MOORE_AUTH_PASSWORD_HASH=
MOORE_AUTH_COOKIE_SECRET=
MOORE_AUTH_MAX_AGE_DAYS=730
MOORE_AUTH_VERSION=1

SKYCAM_ORIGIN_BASE_URL=https://149.28.187.169
SKYCAM_ORIGIN_TOKEN=
SKYCAM_ORIGIN_CA_CERT_B64=
SKYCAM_HISTORY_CACHE_TTL_MS=10000
SKYCAM_ORIGIN_TIMEOUT_MS=10000

# RENDER is set by Render itself. Do not set RENDER=true for local HTTP.
