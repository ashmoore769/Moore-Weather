# Copy to .env for local use. Real values belong only in .env / Render settings.
# Restore existing production values; generating replacements changes authentication.
PORT=10000
WEATHER_STATION_HOST=myweather.ddns.net
WEATHER_STATION_PORT=8899
# TIME checks at startup and 06:05/18:05 Brisbane; SETTIME only for measured drift.
# Enabled by default on Render. Local hardware writes require explicit true.
# Set false on Render to disable clock management.
WEATHER_CLOCK_SYNC_ENABLED=false

# Optional SQL archive (Node 24.14+). Blank means disabled.
# Local: data/weather.sqlite. Render: /var/data/weather.sqlite on a persistent disk.
WEATHER_DB_PATH=
# Optional path to a separately verified sensor/storage layout JSON.
WEATHER_DB_LAYOUT=
# Bounded 4-8 KB memory tails, serialized with normal station polling.
WEATHER_HISTORY_ENABLED=false
# Daily complete encrypted SQLite recovery bundles: three recent + first retention checkpoint.
# Includes weather, push-alert/device state and the access-request queue.
WEATHER_BACKUP_DIR=
# Optional independent recovery key (at least 32 bytes). Defaults to the existing
# MOORE_AUTH_COOKIE_SECRET. Keep the original key when rotating either secret.
WEATHER_BACKUP_ENCRYPTION_KEY=
# Current one-minute R3 readings roll off after 15 days only once the verified
# initial checkpoint is stored offsite. Native historical archives are retained.
# Device push alerts use the same disk; enabled by default when WEATHER_DB_PATH is set.
# Disable when running against a real station during local development.
WEATHER_ALERTS_ENABLED=false

MOORE_AUTH_PASSWORD_HASH=
MOORE_AUTH_COOKIE_SECRET=
MOORE_AUTH_MAX_AGE_DAYS=730
MOORE_AUTH_VERSION=1

# Optional separate station-terminal unlock. A missing hash disables the terminal.
# Store only a salted scrypt hash in Render; never put a password in page source.
MOORE_TERMINAL_PASSWORD_HASH=
# Optional switch to disable the terminal while retaining its hash:
# WEATHER_TERMINAL_ENABLED=false

SKYCAM_ORIGIN_BASE_URL=https://149.28.187.169
SKYCAM_ORIGIN_TOKEN=
SKYCAM_ORIGIN_CA_CERT_B64=
SKYCAM_HISTORY_CACHE_TTL_MS=10000
SKYCAM_ORIGIN_TIMEOUT_MS=10000

# RENDER is set by Render itself. Do not set RENDER=true for local HTTP.
