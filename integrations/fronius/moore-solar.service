[Unit]
Description=Moore Weather Fronius solar collector
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=moore-solar
Group=moore-solar
EnvironmentFile=/etc/moore-solar/collector.env
ExecStart=/usr/bin/python3 -B /opt/moore-solar/collector.py
WorkingDirectory=/var/lib/moore-solar
StateDirectory=moore-solar
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/moore-solar
MemoryHigh=64M
MemoryMax=96M
CPUQuota=20%
TasksMax=16

[Install]
WantedBy=multi-user.target
