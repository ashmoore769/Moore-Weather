# Set the inverter's current LAN address. This is a documentation-only address.
FRONIUS_BASE_URL=http://192.0.2.10

# The exact endpoint, with normal HTTPS certificate verification.
SOLAR_INGEST_URL=https://weather.example.invalid/internal/solar/ingest

# A dedicated random credential, identical to the server's SOLAR_INGEST_TOKEN.
# Do not use the dashboard password, No-IP credentials, or a Fronius password.
SOLAR_INGEST_TOKEN=

SOLAR_POLL_SECONDS=60
SOLAR_STATE_DIR=/var/lib/moore-solar
