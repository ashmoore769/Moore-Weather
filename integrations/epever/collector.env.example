# Dedicated Yard Power telemetry. Copy the settings into the protected Pi config.
# A reserved address is recommended in the home router; leave the Elfin on DHCP.
YARD_POWER_ELFIN_HOST=192.168.86.69
YARD_POWER_ELFIN_PORT=8899
YARD_POWER_INGEST_URL=https://YOUR-WEATHER-HOST/internal/yard-power/ingest
# Must be a different random token from SOLAR_INGEST_TOKEN.
YARD_POWER_INGEST_TOKEN=
YARD_POWER_STATE_DIR=/var/lib/moore-yard-power
