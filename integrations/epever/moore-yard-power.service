[Unit]
Description=Moore Weather EPEVER Yard Power collector (receive-only)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=moore-yard-power
Group=moore-yard-power
EnvironmentFile=/etc/moore-yard-power/collector.env
ExecStart=/usr/bin/python3 -B /opt/moore-yard-power/collector.py
WorkingDirectory=/var/lib/moore-yard-power
StateDirectory=moore-yard-power
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/moore-yard-power
MemoryHigh=64M
MemoryMax=96M
CPUQuota=20%
TasksMax=16

[Install]
WantedBy=multi-user.target
